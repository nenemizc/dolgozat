<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav aria-label="Aloldalak" style="text-align: left;">
        <a href="">Szűrés</a>
        <a href="">Új termék</a>
    </nav>
    <table>
        <thead>
            <tr>
                <th scope="col">Termék neve</th>
                <th scope="col">Kategória</th>
                <th scope="col">Ár</th>
                <th scope="col">Raktárkészlet</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(product => { %>
            <tr class="<%= product.stock < 5 ? 'few' : '' %>">
                <td><%=  product.name %></td>
                <td><%=  product.category %></td>
                <td><%=  product.price %></td>
                <td><%=  product.stock %></td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>