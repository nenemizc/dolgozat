<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <a href="./">Fő oldal</a><br>
    <form action="/new" method="POST">
        <label for="name">Név:</label>
        <input type="text" name="name" id="name">
        <label for="category">Kategória:</label>
        <select name="category" id="category">
            <option value="játék">játék</option>
            <option value="könyv">könyv</option>
            <option value="ruházat">ruházat</option>
            <option value="elektronika">elektonika</option>
        </select>
        <label for="price">Ár:</label>
        <input type="number" name="price" id="price">
        <label for="stock">Raktárkészlet:</label>
        <input type="number" name="stock" id="stock">
        <button type="submit">Felvétel</button>
    </form><br>
    <p style="color: green;" id="successText"><%= success %></p>

</body>
</html>